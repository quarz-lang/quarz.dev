# quarz test scripts/docs_test.qz
#
# The anchors are those GitHub shows for the same headings in the
# language's docs.

require "test"
require_relative "docs"

class AnchorTest < Test::Case
  def test_english
    assert_equal("1-lexical-structure", Docs.anchor("1. Lexical structure"))
    assert_equal("3-the-lock-file-coglock", Docs.anchor("3. The Lock File: `Cog.lock`"))
    assert_equal("2-structured-concurrency-taskscope", Docs.anchor("2. Structured Concurrency (`Task.scope`)"))
    assert_equal("5-actors-and-erlang-style-design", Docs.anchor("5. Actors and Erlang-style Design"))
    assert_equal("channelselect", Docs.anchor("`Channel.select`"))
  end

  def test_japanese
    assert_equal("1-字句", Docs.anchor("1. 字句"))
    assert_equal("13-文字列配列ハッシュのリテラル", Docs.anchor("13. 文字列・配列・ハッシュのリテラル"))
    assert_equal("計算量と一意ならその場で更新", Docs.anchor("計算量と「一意なら、その場で更新」"))
    assert_equal("3-builder可変タスク局所", Docs.anchor("3. Builder(可変・タスク局所)"))
    assert_equal("生存期間と-deinitialize", Docs.anchor("生存期間と `deinitialize`"))
  end

  def test_keeps_underscores_and_link_text
    assert_equal("attr_reader-and-friends", Docs.anchor("`attr_reader` and [friends](01-syntax.md)"))
    assert_equal("_private", Docs.anchor("`_private`"))
  end

  def test_emphasis
    assert_equal("emph-and-strong-snake_case", Docs.anchor("_Emph_ and __strong__ snake_case"))
    assert_equal("a-b", Docs.anchor("*a* **b**"))
  end
end

class ConvertTest < Test::Case
  @doc: Docs::Doc = Docs::Doc.new("docs/01-syntax.md", 1, "syntax", false)

  def convert(text: String) -> String
    Docs.convert(@doc, text, ".", "abc")
  end

  # The page after its front matter, the blank line that follows it and
  # the title's anchor.
  def body(text: String) -> String
    (convert(text).split("+++\n", 3)[2]? || "").sub(/\A\n(<span id="[^"]*"><\/span>\n\n)?/, "")
  end

  def test_front_matter
    page = convert("# Syntax: `def`\n\n日本語版: [01-syntax.ja.md](01-syntax.ja.md)\n\nText.\n")
    assert_equal(
      "+++\ntitle = \"Syntax: def\"\nweight = 1\nslug = \"syntax\"\n\n[extra]\n" \
      "heading = \"Syntax: `def`\"\nsource = \"https://github.com/quarz-lang/quarz/blob/abc/docs/01-syntax.md\"\n+++\n\n<span id=\"syntax-def\"></span>\n\nText.\n",
      page,
    )
  end

  def test_repeated_headings_are_numbered
    assert_equal(
      "## Notes {#notes}\n## Notes {#notes-1}\n### Notes {#notes-2}\n",
      body("# Title\n## Notes\n## Notes\n### Notes\n"),
    )
  end

  def test_links
    assert_equal(
      "See [types](@/docs/types.md#3-generics), [型](@/docs/types.ja.md), `f[x](y)` and [x](https://example.com).\n",
      body("# T\nSee [types](02-types.md#3-generics), [型](02-types.ja.md), `f[x](y)` and [x](https://example.com).\n"),
    )
  end

  def test_code_blocks
    assert_equal(
      "```quarz\n# not a heading\n[a](02-types.md)\n```\n```rb\n```\n```text\n```\n",
      body("# T\n```ruby\n# not a heading\n[a](02-types.md)\n```\n```rb\n```\n```ebnf\n```\n"),
    )
  end

  def test_heading_forms
    assert_equal(
      "## Foo {#foo}\n## Bar {#bar}\n```\n#not\n```\n",
      body("# T\n## Foo ##\n  ## Bar\n```\n#not\n```\n"),
    )
  end

  def test_longer_fences
    assert_equal(
      "````quarz\n```\n## inside\n```\n````\n```quarz\nx\n`````\n## Out {#out}\n",
      body("# T\n````ruby\n```\n## inside\n```\n````\n``` ruby\nx\n`````\n## Out\n"),
    )
  end

  def test_link_forms
    assert_equal(
      "[a](@/docs/types.md \"Types\") [b](<@/docs/types.md>) [c](@/docs/types.md) [d](@/docs/types.ja.md)\n" \
      "[ref]: @/docs/types.md#3-generics \"T\"\n``a`b`` [e](@/docs/types.md)\n",
      body("# T\n[a](02-types.md \"Types\") [b](<02-types.md>) [c](./02-types.md) [d](../docs/02-types.ja.md)\n" \
           "[ref]: 02-types.md#3-generics \"T\"\n``a`b`` [e](02-types.md)\n"),
    )
  end

  def test_other_language_line_only_at_the_top
    assert_equal(
      "Text.\n\nEnglish: [a](01-syntax.md)\n",
      body("# T\n\n日本語版: [x](01-syntax.ja.md)\n\nText.\n\nEnglish: [a](01-syntax.md)\n").gsub("@/docs/syntax.md", "01-syntax.md"),
    )
  end

  def test_more_link_forms
    assert_equal(
      "[a](@/docs/types.md#x 't') [b](@/docs/types.md (t)) [r](https://github.com/quarz-lang/quarz/blob/abc/README.md)\n",
      body("# T\n[a](02-types.md#x 't') [b](02-types.md (t)) [r](../README.md)\n"),
    )
  end

  def test_title_links_and_anchor
    page = convert("# See [types](02-types.md)\n## See types\n")
    assert(page.include?("title = \"See types\"\n"))
    assert(page.include?("heading = \"See [types](@/docs/types.md)\"\n"))
    assert(page.include?("<span id=\"see-types\"></span>\n"))
    assert(page.include?("## See types {#see-types-1}\n"))
  end

  def test_ids_are_unique
    assert_equal(
      "## A {#a}\n## A-1 {#a-1}\n## A {#a-2}\n## \n",
      body("# T\n## A\n## A-1\n## A\n## ##\n"),
    )
  end

  def test_backtick_in_info_string_is_not_a_fence
    assert_equal("```ruby `x`\n## H {#h}\n", body("# T\n```ruby `x`\n## H\n"))
  end

  def test_links_with_code_in_their_text
    assert_equal("attr_reader", Docs.anchor("[`attr_reader`](01-syntax.md)"))
    assert_equal("Task scope", Docs.plain("[`Task`](04-concurrency.md) scope"))
  end

  def test_escapes_and_padded_code
    assert_equal("Foo _bar_", Docs.plain("Foo \\_bar\\_"))
    assert_equal("`a`", Docs.plain("`` `a` ``"))
  end

  def test_footnotes_and_list_fences
    assert_equal(
      "[^1]: See [x](@/docs/types.md).\n- ```quarz\n  ## in\n  ```\n## Out {#out}\n",
      body("# T\n[^1]: See [x](02-types.md).\n- ```ruby\n  ## in\n  ```\n## Out\n"),
    )
  end

  def test_title_without_a_name
    page = convert("# !!!\n## A\n")
    assert(page.include?("title = \"!!!\"\n"))
    assert(page.include?("+++\n\n## A {#a}\n"))
  end

  def test_errors
    assert_raise(Docs::Error) { convert("No heading.\n") }
    assert_raise(Docs::Error) { convert("# \nText.\n") }
    assert_raise(Docs::Error) { convert("# T\n```ruby\nx = 1\n") }
  end
end
