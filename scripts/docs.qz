# What scripts/import_docs.qz does to each of the language's documents,
# apart so that scripts/docs_test.qz can test it (`quarz test
# scripts/docs_test.qz`).
module Docs
  REPO = "https://github.com/quarz-lang/quarz"

  DOC_NAME = /\A(\d\d)-([a-z0-9-]+)(\.ja)?\.md\z/
  DOC_LINK = /\A(\d\d)-([a-z0-9-]+)(\.ja)?\.md(#.*)?\z/
  # A code span (whose text is not a link), or a link's `](target)`, with
  # `<target>` and a `"title"`, `'title'` or `(title)` allowed.
  LINK = /``.+?``|`[^`]*`|\]\(\s*(<[^>\n]*>|[^()\s]+)((?:\s+(?:"[^"]*"|'[^']*'|\([^)]*\)))?\s*)\)/
  # A link reference definition, `[name]: target "title"`.
  # (Not a footnote's, `[^1]: text`.)
  LINK_DEFINITION = /\A( {0,3}\[[^\]^][^\]]*\]:[ \t]*)(<[^>\n]*>|\S+)(.*)\z/
  # A code span, a backslash escape, or a run of other text (for `plain`).
  CODE_OR_TEXT = /``(.+?)``|`([^`]*)`|\\([!-\/:-@\[-`{-~])|([^`\\]+)/
  OTHER_LANGUAGE = /\A(日本語版|English): \[[^\]]*\]\([^)]*\)\s*\z/
  # (Also one opening a list item, `- ```ruby`.)
  FENCE = /\A(\s*(?:(?:[-*+]|\d+[.)])[ \t]+)?)(`{3,}|~{3,})[ \t]*([^\s`]*)(.*)\z/
  # An ATX heading: up to three spaces, 1 to 6 `#`s, then a space or the
  # end (its text may close with `#`s).
  HEADING = /\A {0,3}(\#{1,6})(?:[ \t]+(.*))?\z/
  # Code block languages the site's highlighter does not know, and what
  # it shows them as (an unknown one fails the build, catching a typo).
  LANGUAGES = {"ruby" => "quarz", "ebnf" => "text"}

  data Doc = (path: String, number: Int, slug: String, ja: Bool)

  class Error < StandardError
  end

  # The document `docs/NN-name.md` (or `.ja.md`) at `path`, nil for any
  # other file.
  def self.doc(path: String) -> Doc?
    m = File.basename(path).match(DOC_NAME)
    return nil unless m
    Doc.new(path, m[1].to_s.to_i, m[2].to_s, !m[3].nil?)
  end

  def self.toml_string(s: String) -> String
    "\"" + s.gsub("\\", "\\\\").gsub("\"", "\\\"") + "\""
  end

  # A heading's text as it shows: code spans, emphasis and links reduced
  # to their text. Emphasis is approximated (a `*` is dropped, a `_` at a
  # word's edge too): where GitHub's anchor differs, a link written for it
  # fails `zola build`, which checks anchors.
  #
  # ```
  # Docs.plain("Testing: `quarz test`")              # => "Testing: quarz test"
  # Docs.plain("_Emph_ and __strong__ `a_b` [x](y)") # => "Emph and strong a_b x"
  # ```
  def self.plain(markdown: String) -> String
    # Links first: their text may hold code spans.
    unlinked = markdown.gsub(/\[([^\]]*)\]\([^)]*\)/, "\\1")
    unlinked.gsub(CODE_OR_TEXT) do |_all, md|
      code = md[1]
      code ? code.strip : md[2] || md[3] || strip_emphasis(md[4] || "")
    end
  end

  def self.strip_emphasis(text: String) -> String
    text.gsub("*", "")
        .gsub(/(\A|[^\p{L}\p{N}_])_+/, "\\1")
        .gsub(/_+(\z|[^\p{L}\p{N}_])/, "\\1")
  end

  # The anchor GitHub gives a heading: its plain text in lower case,
  # without punctuation and symbols other than `-` and `_`, spaces made
  # `-`.
  #
  # ```
  # Docs.anchor("1. Lexical structure")              # => "1-lexical-structure"
  # Docs.anchor("4. Data types (`data`)")            # => "4-data-types-data"
  # Docs.anchor("1. 字句")                           # => "1-字句"
  # ```
  def self.anchor(heading: String) -> String
    plain(heading).downcase.gsub(/[^\p{L}\p{Nd}\p{M}\p{Pc}\- ]/, "").gsub(" ", "-")
  end

  # A link's target as the site writes it: another document as an internal
  # link, a file of the repository as a GitHub URL, anything else (a URL,
  # an anchor, text in parentheses after brackets) as it is.
  def self.link_target(target: String, quarz_dir: String, commit: String) -> String
    return target if target.match?(/\A([a-z][a-z0-9+.-]*:|#|@\/)/)
    # Relative to docs/: `../crates/x.rs` is crates/x.rs.
    path = target.delete_prefix("./")
    path = path.start_with?("../") ? path[3..] : "docs/#{path}"
    m = path.delete_prefix("docs/").match(DOC_LINK) if path.start_with?("docs/")
    if m
      lang = m[3] ? ".ja" : ""
      return "@/docs/#{m[2]}#{lang}.md#{m[4] || ""}"
    end
    file = path.sub(/#.*\z/, "")
    return target unless File.exist?("#{quarz_dir}/#{file}")
    "#{REPO}/blob/#{commit}/#{path}"
  end

  # `link_target` of a target that may be written `<target>`.
  def self.rewrite_target(target: String, quarz_dir: String, commit: String) -> String
    bracketed = target.start_with?("<") && target.end_with?(">")
    rewritten = link_target(bracketed ? target[1..-2] : target, quarz_dir, commit)
    bracketed ? "<#{rewritten}>" : rewritten
  end

  # The page the site makes of `doc`, whose text is `text`. Its title is
  # the plain text of the first `# ` heading; `extra.heading` keeps the
  # heading's Markdown, for the page's `<h1>`, and the page starts with an
  # element holding its anchor.
  #
  # ## Raises
  #
  # `Docs::Error` for a document without a `# ` heading (or with an empty
  # one) or with an unterminated code block.
  def self.convert(doc: Doc, text: String, quarz_dir: String, commit: String) -> String
    title: String? = nil
    body = Array::Builder[String].new
    # The open code block's fence (`` ``` ``, `~~~~`, ...).
    fence: String? = nil
    skip_blank = false
    # Whether a line other than the title and blank lines has been kept:
    # the line linking to the other language comes before any.
    started = false
    # GitHub numbers a heading's anchor that an earlier one already has
    # (`a`, `a-1`, ...), skipping ids given out already.
    anchors: Hash[String, Int] = {}
    used: Set[String] = Set.new
    title_id = ""
    text.lines(chomp: true).each do |line|
      if skip_blank
        skip_blank = false
        next if line.strip.empty?
      end
      m = line.match(FENCE)
      open_fence = fence
      if open_fence
        # Closed by a fence of the same character, at least as long,
        # with nothing after it.
        if m && m[2].to_s[0] == open_fence[0] && m[2].to_s.size >= open_fence.size &&
           m[3].to_s.empty? && m[4].to_s.strip.empty?
          fence = nil
        end
        body << line
        next
      end
      # A backtick fence's info string has no backtick (`` ```ruby `x` ``
      # is inline code).
      m = nil if m && !open_fence && m[2].to_s[0] == "`" && m[4].to_s.include?("`")
      if m
        fence = m[2]
        lang = m[3].to_s
        body << "#{m[1]}#{m[2]}#{LANGUAGES[lang]? || lang}#{m[4]}"
        started = true
        next
      end
      if (h = line.match(HEADING))
        heading = (h[2] || "").sub(/(\A|[ \t]+)\#+[ \t]*\z/, "").strip
        if title.nil? && h[1] == "#" && heading.empty?
          raise Error, "#{doc.path}: an empty `#` heading"
        end
        base = anchor(heading)
        if base.empty? && !(title.nil? && h[1] == "#")
          # Nothing to name it by (`## ##`): no anchor.
          body << "#{h[1]} #{heading}"
          started = true
          next
        end
        n = anchors[base]? || 0
        n = 0 if base.empty?
        id = n == 0 ? base : "#{base}-#{n}"
        while !base.empty? && used.include?(id)
          n += 1
          id = "#{base}-#{n}"
        end
        anchors = anchors.put(base, n + 1)
        used = used.add(id)
        if title.nil? && h[1] == "#"
          title = heading
          title_id = id
          skip_blank = true
        else
          body << "#{h[1]} #{rewrite_links(heading, quarz_dir, commit)} {##{id}}"
          started = true
        end
        next
      end
      if !started && line.match?(OTHER_LANGUAGE)
        skip_blank = true
        next
      end
      started = true unless line.strip.empty?
      body << rewrite_links(line, quarz_dir, commit)
    end
    raise Error, "#{doc.path}: an unterminated code block" if fence
    heading = title
    raise Error, "#{doc.path}: no `# ` heading" unless heading
    front = [
      "+++",
      "title = #{toml_string(plain(heading))}",
      "weight = #{doc.number}",
      "slug = #{toml_string(doc.slug)}",
      "",
      "[extra]",
      "heading = #{toml_string(rewrite_links(heading, quarz_dir, commit))}",
      "source = #{toml_string("#{REPO}/blob/#{commit}/docs/#{File.basename(doc.path)}")}",
      "+++",
      "",
    ]
    # The title's anchor, which the template's `<h1>` cannot give in a way
    # `zola build` checks links against.
    top: Array[String] = title_id.empty? ? [] : ["<span id=\"#{title_id}\"></span>", ""]
    (front + top + body.to_a).join("\n") + "\n"
  end

  def self.rewrite_links(line: String, quarz_dir: String, commit: String) -> String
    d = line.match(LINK_DEFINITION)
    if d
      return "#{d[1]}#{rewrite_target(d[2].to_s, quarz_dir, commit)}#{d[3]}"
    end
    # (A footnote's text, `[^1]: ...`, is rewritten as any line.)
    line.gsub(LINK) do |all, md|
      target = md[1]
      target ? "](#{rewrite_target(target, quarz_dir, commit)}#{md[2]})" : all
    end
  end
end
